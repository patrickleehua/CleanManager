{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cleanmanager:run-record:1.0",
  "title": "CleanManager verification run record (pre-implementation draft)",
  "description": "One execution of a verification-plan test on a real device. expected is written before the run; actual stays null until observed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "test_id", "run_id", "recorded_at", "code_commit", "binary_sha256", "device_id", "os",
    "filesystem", "permission_context", "scope_digest", "fixture_manifest_sha256", "backend", "config",
    "command", "seed", "expected", "actual", "terminal_state", "exit_code", "measurements", "observer",
    "limitations", "status"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "test_id": { "type": "string", "pattern": "^(TC-[A-Z0-9]+-[0-9]{3}|SCN-[0-9]{2}|[A-Z]{3}-[0-9]{2})$" },
    "run_id": { "type": "string", "pattern": "^run_[a-z0-9_-]{3,64}$" },
    "recorded_at": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "code_commit": { "type": ["string", "null"], "pattern": "^[a-f0-9]{40}$" },
    "binary_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "device_id": { "type": "string", "minLength": 1 },
    "os": {
      "type": "object", "additionalProperties": false, "required": ["platform", "name", "build", "architecture"],
      "properties": {
        "platform": { "enum": ["windows", "macos"] },
        "name": { "type": ["string", "null"] },
        "build": { "type": ["string", "null"] },
        "architecture": { "enum": ["x64", "arm64", null] }
      }
    },
    "filesystem": {
      "type": "object", "additionalProperties": false, "required": ["type", "volume_id"],
      "properties": { "type": { "type": ["string", "null"] }, "volume_id": { "type": ["string", "null"] } }
    },
    "permission_context": {
      "type": "object", "additionalProperties": false, "required": ["elevated", "signing_identity", "grants"],
      "properties": {
        "elevated": { "type": ["boolean", "null"] },
        "signing_identity": { "type": ["string", "null"] },
        "grants": { "type": "array", "items": { "type": "string" } }
      }
    },
    "scope_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "fixture_manifest_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "backend": { "type": ["string", "null"] },
    "config": { "type": "object" },
    "command": { "type": "array", "items": { "type": "string" } },
    "seed": { "type": ["integer", "null"], "minimum": 0 },
    "expected": { "type": "string", "minLength": 1 },
    "actual": { "type": ["string", "null"], "minLength": 1 },
    "terminal_state": { "type": ["string", "null"] },
    "exit_code": { "type": ["integer", "null"] },
    "measurements": { "type": "object" },
    "observer": { "type": ["string", "null"] },
    "limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["unverified", "passed", "failed", "incomplete"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "unverified" } } },
      "then": { "properties": { "actual": { "type": "null" } } },
      "else": { "properties": { "actual": { "type": "string" }, "terminal_state": { "type": "string" }, "observer": { "type": "string" } } }
    }
  ]
}
