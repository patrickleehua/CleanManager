{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:cleanmanager:tested-registry:1.0",
  "title": "CleanManager tested-application registry entry (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "registry_id", "rule_id", "rule_version", "synthetic", "subject",
    "version_range", "platforms", "tested_at", "result", "fixtures", "known_effects", "evidence_refs"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "registry_id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "rule_id": { "type": "string", "pattern": "^[a-z0-9]+(\\.[a-z0-9_-]+)+$" },
    "rule_version": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$" },
    "synthetic": { "type": "boolean" },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id", "name"],
      "properties": {
        "kind": { "enum": ["app", "tool", "system"] },
        "id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "version_range": {
      "type": "object", "additionalProperties": false, "required": ["min_inclusive", "max_exclusive"],
      "properties": {
        "min_inclusive": { "type": "string", "minLength": 1, "maxLength": 64 },
        "max_exclusive": { "type": ["string", "null"], "minLength": 1, "maxLength": 64 }
      }
    },
    "platforms": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["platform", "os_versions", "architectures"],
        "properties": {
          "platform": { "enum": ["windows", "macos"] },
          "os_versions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
          "architectures": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["x64", "arm64"] } }
        }
      }
    },
    "tested_at": { "type": "string", "format": "date" },
    "result": { "enum": ["passed", "failed"] },
    "fixtures": {
      "type": "object", "additionalProperties": false, "required": ["positive", "negative"],
      "properties": {
        "positive": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "negative": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "known_effects": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "evidence_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
