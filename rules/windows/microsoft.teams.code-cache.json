{
  "schema_version": "2.0",
  "rule_id": "microsoft.teams.code-cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "windows"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "local_rebuild",
  "owner": {
    "kind": "app",
    "id": "microsoft.teams"
  },
  "root_resolver": "app_container",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "EBWebView"
    ],
    "name_glob": "Code Cache",
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 1
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Microsoft Teams (new Teams) WebView2 V8 code cache.",
    "regeneration": "Rebuilt when Teams runs again.",
    "offline_effect": "None expected: chats and files are in the cloud and not inside."
  },
  "tested_registry_ref": null,
  "evidence_refs": [
    "run_win_catalog_microsoft_teams_code_cache"
  ]
}
