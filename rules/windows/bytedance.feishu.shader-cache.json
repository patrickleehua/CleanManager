{
  "schema_version": "2.0",
  "rule_id": "bytedance.feishu.shader-cache",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "local_rebuild",
  "owner": {
