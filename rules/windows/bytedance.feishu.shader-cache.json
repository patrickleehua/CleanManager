    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Feishu (Lark) desktop Chromium GPU shader caches (LarkShell\\GrShaderCache and ShaderCache).",
