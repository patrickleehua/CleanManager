{
  "schema_version": "2.0",
  "rule_id": "windows.downloads.incomplete",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "incomplete_downloads",
  "max_tier": "review_only",
  "rebuild_class": "not_rebuildable",
  "owner": {
    "kind": "system",
    "id": "windows.downloads"
  },
  "root_resolver": "installer_location",
  "match": {
    "object_type": "file",
    "relative_components": [],
    "name_glob": null,
    "extensions": [
      "crdownload",
      "part",
      "partial"
    ],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "incomplete_download_handle"
  ],
  "thresholds": {
    "min_age_days": 7,
    "age_basis": "modified_time",
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Unfinished browser download files (*.crdownload, *.part, *.partial) directly in Downloads, untouched for at least 7 days.",
    "regeneration": "Not regenerated: the download has to be started again.",
    "offline_effect": "A paused download that was meant to be resumed cannot be resumed."
  },
  "tested_registry_ref": "windows.downloads.incomplete@1.0.0",
  "evidence_refs": [
    "run_win_catalog_windows_downloads_incomplete"
  ]
}
