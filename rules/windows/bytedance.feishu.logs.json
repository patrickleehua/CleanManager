{
  "schema_version": "2.0",
  "rule_id": "bytedance.feishu.logs",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "logs",
  "max_tier": "review_only",
  "rebuild_class": "not_rebuildable",
  "owner": {
    "kind": "app",
    "id": "bytedance.feishu"
  },
  "root_resolver": "user_logs",
  "match": {
    "object_type": "file",
    "relative_components": [],
    "name_glob": null,
    "extensions": [
      "alaudalog"
    ],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 1
  },
  "exclude": [],
  "probes": [
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": 7,
    "age_basis": "modified_time",
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Feishu (Lark) rotated diagnostic logs (*.alaudalog) older than 7 days in LarkShell\\sdk_storage\\log.",
    "regeneration": "Not regenerated: logs of past Feishu sessions.",
    "offline_effect": "None for messaging; the logs are no longer available when contacting Feishu support."
  },
  "tested_registry_ref": "bytedance.feishu.logs@1.0.0",
  "evidence_refs": [
    "run_win_catalog_bytedance_feishu_logs"
  ]
}
