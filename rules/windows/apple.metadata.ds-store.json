{
  "schema_version": "2.0",
  "rule_id": "apple.metadata.ds-store",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "windows"
  ],
  "category": "removable_metadata",
  "max_tier": "review_only",
  "rebuild_class": "not_rebuildable",
  "owner": {
    "kind": "system",
    "id": "apple.metadata"
  },
  "root_resolver": "removable_volume_root",
  "match": {
    "object_type": "file",
    "relative_components": [],
    "name_glob": ".DS_Store",
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 8
  },
  "exclude": [],
  "probes": [],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "macOS Finder view-settings files (.DS_Store) on a removable volume you selected; only that volume is examined.",
    "regeneration": "Not needed by Windows; a Mac recreates them when the volume is used there again.",
    "offline_effect": "A Mac loses Finder view settings, resource forks or extended attributes stored in these files."
  },
  "tested_registry_ref": null,
  "evidence_refs": [
    "run_win_catalog_apple_metadata_ds_store"
  ]
}
