{
  "schema_version": "2.0",
  "rule_id": "discord.code-cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "windows"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "local_rebuild",
  "owner": {
    "kind": "app",
    "id": "discord"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "Code Cache"
    ],
    "name_glob": null,
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Discord desktop (Electron) V8 code cache.",
    "regeneration": "Rebuilt when Discord runs again.",
    "offline_effect": "None expected."
  },
  "tested_registry_ref": null,
  "evidence_refs": [
    "run_win_catalog_discord_code_cache"
  ]
}
