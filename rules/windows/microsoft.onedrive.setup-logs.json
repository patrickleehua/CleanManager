{
  "schema_version": "2.0",
  "rule_id": "microsoft.onedrive.setup-logs",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "cloud_office",
  "max_tier": "review_only",
  "rebuild_class": "not_rebuildable",
  "owner": {
    "kind": "app",
    "id": "microsoft.onedrive"
  },
  "root_resolver": "user_logs",
  "match": {
    "object_type": "file",
    "relative_components": [
      "setup",
      "logs"
    ],
    "name_glob": null,
    "extensions": [
      "log",
      "odl",
      "aodl"
    ],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": 7,
    "age_basis": "modified_time",
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "OneDrive installer and updater logs older than 7 days (OneDrive\\setup\\logs).",
    "regeneration": "Not regenerated: logs of past installs and updates.",
    "offline_effect": "None for syncing; update troubleshooting history is lost."
  },
  "tested_registry_ref": "microsoft.onedrive.setup-logs@1.0.0",
  "evidence_refs": [
    "run_win_catalog_microsoft_onedrive_setup_logs"
  ]
}
