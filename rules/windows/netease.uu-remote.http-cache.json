{
  "schema_version": "2.0",
  "rule_id": "netease.uu-remote.http-cache",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "app",
    "id": "netease.uu-remote"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "Default",
      "Cache",
      "Cache_Data"
    ],
    "name_glob": null,
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "UU Remote (NetEase GameViewer) embedded WebView2 HTTP cache.",
    "regeneration": "Interface resources are downloaded again when next needed.",
    "offline_effect": "Pages that were only cached cannot be shown offline until downloaded again."
  },
  "tested_registry_ref": "netease.uu-remote.http-cache@1.0.0",
  "evidence_refs": [
    "run_win_catalog_netease_uu_remote_http_cache"
  ]
}
