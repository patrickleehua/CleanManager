{
  "schema_version": "2.0",
  "rule_id": "adobe.media-cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "windows"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "local_rebuild",
  "owner": {
    "kind": "app",
    "id": "adobe.creative-cloud"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "Media Cache Files"
    ],
    "name_glob": null,
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Adobe Premiere Pro / After Effects / Media Encoder media cache (conformed audio and indexes). Project files and source media are not here.",
    "regeneration": "Rebuilt from the source media when projects are opened again; this can take a while for large projects.",
    "offline_effect": "Projects whose source media is offline cannot rebuild the cache until the media is available."
  },
  "tested_registry_ref": null,
  "evidence_refs": [
    "run_win_catalog_adobe_media_cache"
  ]
}
