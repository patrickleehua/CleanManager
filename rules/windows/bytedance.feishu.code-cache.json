{
  "schema_version": "2.0",
  "rule_id": "bytedance.feishu.code-cache",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "local_rebuild",
  "owner": {
    "kind": "app",
    "id": "bytedance.feishu"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "CodeCache"
    ],
    "name_glob": null,
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Feishu (Lark) desktop V8 script code cache (LarkShell\\CodeCache), one folder per engine version.",
    "regeneration": "Feishu compiles its scripts again on the next start; the first start may be slower.",
    "offline_effect": "None expected: no chats, files, account or settings are inside."
  },
  "tested_registry_ref": "bytedance.feishu.code-cache@1.0.0",
  "evidence_refs": [
    "run_win_catalog_bytedance_feishu_code_cache"
  ]
}
