{
  "schema_version": "2.0",
  "rule_id": "python.install-manager.downloads",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "developer",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "tool",
    "id": "python.install-manager"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "file",
    "relative_components": [
      "_cache"
    ],
    "name_glob": null,
    "extensions": [
      "zip"
    ],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Python install manager download cache: runtime packages (*.zip) kept after installation in Local AppData\\Python\\_cache.",
    "regeneration": "Downloaded again only if the same runtime is reinstalled; installed runtimes are not affected.",
    "offline_effect": "Reinstalling a runtime offline fails until the network is available."
  },
  "tested_registry_ref": "python.install-manager.downloads@1.0.0",
  "evidence_refs": [
    "run_win_catalog_python_install_manager_downloads"
  ]
}
