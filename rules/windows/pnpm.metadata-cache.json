{
  "schema_version": "2.0",
  "rule_id": "pnpm.metadata-cache",
  "version": "1.0.0",
  "status": "enabled",
  "platforms": [
    "windows"
  ],
  "category": "developer",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "tool",
    "id": "pnpm"
  },
  "root_resolver": "package_manager_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [],
    "name_glob": "metadata*",
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "pnpm registry metadata cache (pnpm-cache\\metadata-*). The content-addressable package store is not here and is never matched.",
    "regeneration": "Package metadata is fetched from the registry again on the next install.",
    "offline_effect": "Offline installs (pnpm install --offline) that need removed metadata fail until the network is available."
  },
  "tested_registry_ref": "pnpm.metadata-cache@1.0.0",
  "evidence_refs": [
    "run_win_catalog_pnpm_metadata_cache"
  ]
}
