{
  "schema_version": "2.0",
  "rule_id": "microsoft.onedrive.logs",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "cloud_office",
  "max_tier": "review_only",
  "rebuild_class": "not_rebuildable",
  "owner": {
    "kind": "app",
    "id": "microsoft.onedrive"
  },
  "root_resolver": "user_logs",
  "match": {
    "object_type": "file",
    "relative_components": [],
    "name_glob": null,
    "extensions": [
      "odl",
      "odlgz",
      "aodl",
      "loggz",
      "log"
    ],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 2
  },
  "exclude": [],
  "probes": [
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": 7,
    "age_basis": "modified_time",
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "OneDrive sync client diagnostic logs (~/Library/Logs/OneDrive, *.odl/*.odlgz/*.aodl/*.loggz/*.log) older than 7 days; never synced files.",
    "regeneration": "Not regenerated: records of past sync sessions.",
    "offline_effect": "Microsoft support can no longer use these logs for troubleshooting. Synced content and the sync settings are never matched."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
