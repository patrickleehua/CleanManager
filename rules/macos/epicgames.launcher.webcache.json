    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Epic Games Launcher web cache (~/Library/Application Support/Epic/EpicGamesLauncher/Saved/webcache*).",
    "regeneration": "The launcher downloads its store and library pages again.",
    "offline_effect": "Store pages need the network again. Installed games and their manifests are never matched."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
