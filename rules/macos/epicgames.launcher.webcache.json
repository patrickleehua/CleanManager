{
  "schema_version": "2.0",
  "rule_id": "epicgames.launcher.webcache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "app",
    "id": "epicgames.launcher"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [],
    "name_glob": "webcache*",
    "extensions": [],
