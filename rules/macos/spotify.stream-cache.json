{
  "schema_version": "2.0",
  "rule_id": "spotify.stream-cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "app",
    "id": "spotify"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "Data"
    ],
    "name_glob": null,
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Spotify streaming cache (~/Library/Caches/com.spotify.client/Data).",
    "regeneration": "Spotify downloads tracks again as they are played.",
    "offline_effect": "Recently played tracks stream again from the network. Songs downloaded for offline listening (Application Support/Spotify/PersistentCache) are never matched."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
