{
  "schema_version": "2.0",
  "rule_id": "macos.system-logs.rotated",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "logs",
  "max_tier": "review_only",
  "rebuild_class": "not_rebuildable",
  "owner": {
    "kind": "system",
    "id": "macos.var-log"
  },
  "root_resolver": "system_logs",
  "match": {
    "object_type": "file",
    "relative_components": [],
    "name_glob": null,
    "extensions": [
      "gz",
      "bz2"
    ],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 1
  },
  "exclude": [],
  "probes": [
    "open_file_handle",
    "elevated_token"
  ],
  "thresholds": {
    "min_age_days": 7,
    "age_basis": "modified_time",
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": true,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Rotated (compressed) system logs in /private/var/log (*.gz, *.bz2) older than 7 days; the active logs are never matched. Administrator only.",
    "regeneration": "Not regenerated: newsyslog keeps writing the active logs and rotates them again.",
    "offline_effect": "Older system log history is no longer available for troubleshooting. Skipped unless this tool runs as root (this build has no privileged helper on macOS)."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
