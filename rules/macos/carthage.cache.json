{
  "schema_version": "2.0",
  "rule_id": "carthage.cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "developer",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "tool",
    "id": "carthage"
  },
  "root_resolver": "package_manager_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [],
    "name_glob": "*",
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Carthage cache (~/Library/Caches/org.carthage.CarthageKit/*: dependency repositories, prebuilt binaries and their build products).",
    "regeneration": "Carthage clones, downloads and builds the dependencies again on the next `carthage bootstrap` or `update`.",
    "offline_effect": "Resolving dependencies without the network is no longer possible. Projects' own Carthage/Build folders are never matched."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
