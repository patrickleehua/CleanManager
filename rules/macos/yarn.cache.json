{
  "schema_version": "2.0",
  "rule_id": "yarn.cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "developer",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "tool",
    "id": "yarn"
  },
  "root_resolver": "package_manager_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [],
    "name_glob": "v*",
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Yarn (classic) package cache folders (~/Library/Caches/Yarn/v*).",
    "regeneration": "Packages are downloaded again on the next install.",
    "offline_effect": "Offline installs of removed packages fail until the network is available."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
