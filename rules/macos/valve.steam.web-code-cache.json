{
  "schema_version": "2.0",
  "rule_id": "valve.steam.web-code-cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "local_rebuild",
  "owner": {
    "kind": "app",
    "id": "valve.steam"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "config",
      "htmlcache"
    ],
    "name_glob": "Code Cache",
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 1
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Steam client built-in browser code cache (~/Library/Application Support/Steam/config/htmlcache/.../Code Cache).",
    "regeneration": "Rebuilt when the Steam store and library pages are opened again.",
    "offline_effect": "None expected: installed games (steamapps), saves (userdata) and the sign-in are never matched."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
