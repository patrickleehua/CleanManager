{
  "schema_version": "2.0",
  "rule_id": "figma.code-cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "app_caches",
  "max_tier": "review_only",
  "rebuild_class": "local_rebuild",
  "owner": {
    "kind": "app",
    "id": "figma"
  },
  "root_resolver": "application_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [],
    "name_glob": "Code Cache",
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 2
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Figma desktop (Electron) V8 code caches (~/Library/Application Support/Figma, `Code Cache` up to two levels deep).",
    "regeneration": "Rebuilt when Figma runs again.",
    "offline_effect": "None expected: design files live in the Figma service; local fonts and settings are not matched."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
