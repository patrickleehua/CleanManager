{
  "schema_version": "2.0",
  "rule_id": "cargo.registry-cache",
  "version": "1.0.0",
  "status": "experimental",
  "platforms": [
    "macos"
  ],
  "category": "developer",
  "max_tier": "review_only",
  "rebuild_class": "network_redownload",
  "owner": {
    "kind": "tool",
    "id": "cargo"
  },
  "root_resolver": "package_manager_cache",
  "match": {
    "object_type": "directory",
    "relative_components": [
      "registry",
      "cache"
    ],
    "name_glob": null,
    "extensions": [],
    "require_cachedir_tag": false,
    "archive_payload": false,
    "max_depth": 0
  },
  "exclude": [],
  "probes": [
    "owner_process",
    "open_file_handle"
  ],
  "thresholds": {
    "min_age_days": null,
    "age_basis": null,
    "min_size_bytes": null,
    "retention_days": null
  },
  "action_kind": "filesystem",
  "adapter_ref": null,
  "allowed_modes": [
    "trash",
    "quarantine"
  ],
  "requires_admin": false,
  "protect_descendants": true,
  "follow_links": false,
  "impact": {
    "summary": "Downloaded crate archives (.crate) in Cargo's registry cache; the extracted sources (registry/src) and Git checkouts are kept.",
    "regeneration": "Crates are downloaded again by the next build that needs them.",
    "offline_effect": "Offline builds that need removed crates fail until the network is available."
  },
  "tested_registry_ref": null,
  "evidence_refs": []
}
