{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "CleanManager host commands for the main window. No shell, fs, opener or dialog permissions are exposed to the WebView; folder picking (scan roots, purge roots) happens in Rust and returns an opaque token or root id. No command accepts a filesystem path or a plan body: plans, operations, quarantine items and policies are named by store-issued ids, and approval needs a host-issued review token plus the typed digest prefix. AI diagnosis commands take scan/entry/preview/diagnosis ids only; provider keys are entered in the system credential prompt and never cross IPC.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-capabilities",
    "allow-list-scan-roots",
    "allow-choose-folder",
    "allow-recent-scans",
    "allow-start-scan",
    "allow-scan-status",
    "allow-cancel-scan",
    "allow-list-entries",
    "allow-treemap-layer",
    "allow-summarize-selection",
    "allow-candidate-summary",
    "allow-analyze-scan",
    "allow-list-candidates",
    "allow-create-plan",
    "allow-plan-detail",
    "allow-plan-items",
    "allow-approve-plan",
    "allow-revoke-plan",
    "allow-list-policies",
    "allow-set-policy-state-cmd",
    "allow-create-policy-from-plan",
    "allow-start-apply",
    "allow-cancel-apply",
    "allow-active-apply",
    "allow-operation-detail",
    "allow-list-operation-items",
    "allow-reconcile-operation",
    "allow-list-operations",
    "allow-list-plans",
    "allow-list-quarantine",
    "allow-create-recovery-plan",
    "allow-purge-roots",
    "allow-purge-roots-add",
    "allow-purge-roots-remove",
    "allow-purge-scan",
    "allow-installer-locations",
    "allow-installer-scan",
    "allow-create-catalog-plan",
    "allow-trash-inspect",
    "allow-trash-plan",
    "allow-startup-list",
    "allow-startup-plan",
    "allow-insights-list",
    "allow-status-snapshot",
    "allow-readiness",
    "allow-reveal-entry",
    "allow-list-protection",
    "allow-add-protection",
    "allow-remove-protection",
    "allow-list-apps",
    "allow-diag-status",
    "allow-diag-save-provider",
    "allow-diag-choose-cli",
    "allow-diag-remove-provider",
    "allow-diag-set-key",
    "allow-diag-forget-key",
    "allow-diag-probe",
    "allow-diag-prepare",
    "allow-diag-follow-up",
    "allow-diag-discard",
    "allow-diag-confirm",
    "allow-diag-cancel",
    "allow-diag-get",
    "allow-diag-list",
    "allow-diag-save",
    "allow-diag-remove",
    "allow-diag-export",
    "allow-diag-handoff"
  ]
}
