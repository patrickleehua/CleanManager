{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Read-only CleanManager host commands for the main window. No shell, fs, opener or dialog permissions are exposed to the WebView; folder picking happens in Rust and returns an opaque root token.",
  "local": true,
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-capabilities",
    "allow-list-scan-roots",
    "allow-choose-folder",
    "allow-recent-scans",
    "allow-start-scan",
    "allow-scan-status",
    "allow-cancel-scan",
    "allow-list-entries",
    "allow-treemap-layer",
    "allow-summarize-selection"
  ]
}
